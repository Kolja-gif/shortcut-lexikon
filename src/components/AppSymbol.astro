---
// Das App-Symbol: weißes Lucide-Icon auf abgerundetem Quadrat in der App-Farbe,
// wie in den macOS-Systemeinstellungen.
import Icon from './Icon.astro';

interface Props {
  icon: string;
  farbe: string;
  groesse?: number;
}

const { icon, farbe, groesse = 22 } = Astro.props;
---

<span class="app-symbol" style={`--farbe: ${farbe}; --groesse: ${groesse}px`}>
  <Icon name={icon} groesse={Math.round(groesse * 0.6)} />
</span>

<style>
  .app-symbol {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--groesse);
    height: var(--groesse);
    border-radius: calc(var(--groesse) * 0.26);
    color: #fff;
    background: linear-gradient(180deg, color-mix(in srgb, var(--farbe) 82%, #fff), var(--farbe));
    box-shadow:
      inset 0 0 0 0.5px rgb(0 0 0 / 0.12),
      0 0.5px 1px rgb(0 0 0 / 0.12);
  }
</style>
