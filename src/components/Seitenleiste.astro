---
import { ladeApps, pfad } from '../lib/apps';
import AppSymbol from './AppSymbol.astro';
import Icon from './Icon.astro';

interface Props {
  /** "start" oder die id der aktuellen App */
  aktiv: string;
}

const { aktiv } = Astro.props;
const apps = await ladeApps();
const gesamt = apps.reduce((summe, a) => summe + a.app.anzahl, 0);
---

<nav class="seitenleiste" aria-label="Apps">
  <a class="marke" href={pfad()}>
    <Icon name="command" groesse={15} />
    <span>Shortcut-Lexikon</span>
  </a>

  <div class="eintraege">
    <ul class="liste">
      <li>
        <a
          class:list={['eintrag', { aktiv: aktiv === 'start' }]}
          href={pfad()}
          aria-current={aktiv === 'start' ? 'page' : undefined}
          style="--akzent: var(--neutral-akzent)"
        >
          <AppSymbol icon="layout-grid" farbe="#8E8E93" />
          <span class="eintrag__name">Übersicht</span>
          <span class="eintrag__anzahl">{gesamt}</span>
        </a>
      </li>
    </ul>

    <p class="abschnitt">Apps</p>
    <ul class="liste">
      {
        apps.map(({ app }) => (
          <li>
            <a
              class:list={['eintrag', { aktiv: aktiv === app.id }]}
              href={pfad(`${app.id}/`)}
              aria-current={aktiv === app.id ? 'page' : undefined}
              style={`--akzent: ${app.farbe}`}
            >
              <AppSymbol icon={app.icon} farbe={app.farbe} />
              <span class="eintrag__name">{app.name}</span>
              <span class="eintrag__anzahl">{app.anzahl}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .seitenleiste {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 18px 10px 24px;
    background: var(--seitenleiste);
    border-right: 1px solid var(--linie);
  }

  .marke {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 18px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
  }

  .abschnitt {
    margin: 18px 10px 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-3);
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }

  .eintrag {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 5px 10px;
    border-radius: 7px;
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
    transition: background-color 0.12s;
  }

  .eintrag:hover {
    background: var(--hover);
  }

  .eintrag.aktiv {
    background: color-mix(in srgb, var(--akzent) 16%, transparent);
  }

  .eintrag.aktiv .eintrag__name {
    font-weight: 600;
  }

  .eintrag__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .eintrag__anzahl {
    font-size: 12px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .seitenleiste {
      position: static;
      height: auto;
      padding: 12px 12px 10px;
      border-right: none;
      border-bottom: 1px solid var(--linie);
    }
    .marke {
      padding-bottom: 10px;
    }
    .abschnitt {
      display: none;
    }
    /* Auf schmalen Bildschirmen: eine Zeile, seitlich wischbar */
    .eintraege {
      display: flex;
      gap: 4px;
      margin: 0 -12px;
      padding: 0 12px 2px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .liste {
      display: flex;
      gap: 4px;
    }
    .eintrag {
      white-space: nowrap;
    }
    .eintrag__anzahl {
      display: none;
    }
  }
</style>
